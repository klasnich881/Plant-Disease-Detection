# Raw dataset images
data/raw/*
!data/raw/.gitkeep

# Cached features & trained models (too large for Git)
approach_a/outputs/features/*
!approach_a/outputs/features/.gitkeep
approach_a/outputs/models/*
!approach_a/outputs/models/.gitkeep

approach_b/outputs/models/*
!approach_b/outputs/models/.gitkeep

# Model weights & arrays anywhere in repo
*.npz
*.joblib
*.pth
*.pt

# Virtual environments & Python cache
venv/
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env

# OS & editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/